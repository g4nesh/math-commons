{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/g4nesh/math-commons/raw/main/research/marcus-de-oliveira/certificates/witness.schema.json",
  "title": "Exact Gaussian-rational MDO finite witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "a",
    "b",
    "U"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "a": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/complex"
      }
    },
    "b": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/complex"
      }
    },
    "U": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "$ref": "#/$defs/complex"
        }
      }
    },
    "expectedDeterminant": {
      "$ref": "#/$defs/complex"
    }
  },
  "$defs": {
    "rational": {
      "type": "string",
      "pattern": "^[+-]?[0-9]{1,64}(?:/[1-9][0-9]{0,63})?$"
    },
    "complex": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/rational"
      }
    }
  },
  "$comment": "The executable additionally requires matching spectrum lengths, a square U of that dimension, exact unitarity, unique JSON keys, and input size <=1 MiB."
}
