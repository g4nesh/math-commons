import Std

/-! An exact, rational-plane instance of the determinantal convex-hull question.
The two coordinates encode the real and imaginary parts of a Gaussian rational. -/
namespace MathCommons

abbrev Point := Rat × Rat
abbrev I := Fin 3
abbrev Matrix3 := I → I → Point

def add (a b : Point) : Point := (a.1 + b.1, a.2 + b.2)
def neg (a : Point) : Point := (-a.1, -a.2)
def scale (w : Rat) (a : Point) : Point := (w * a.1, w * a.2)
def mul (a b : Point) : Point := (a.1 * b.1 - a.2 * b.2, a.1 * b.2 + a.2 * b.1)
def mix (t : Rat) (x y : Point) : Point := add (scale t x) (scale (1-t) y)

/-- Finite convex combinations over the rational plane, generated by binary interpolation. -/
inductive InHull (vertices : List Point) : Point → Prop where
  | vertex {p} : p ∈ vertices → InHull vertices p
  | blend {x y t} : 0 ≤ t → t ≤ 1 → InHull vertices x → InHull vertices y → InHull vertices (mix t x y)

/-- Every certificate stays inside every set containing the vertices and closed
under rational line segments. This also applies to preimages of convex sets. -/
theorem inEveryConvexSet {vs : List Point} {p : Point} (certificate : InHull vs p)
    (P : Point → Prop) (base : ∀ x ∈ vs, P x)
    (segment : ∀ x y t, 0 ≤ t → t ≤ 1 → P x → P y → P (mix t x y)) : P p := by
  induction certificate with
  | vertex h => exact base _ h
  | blend lo hi _ _ left right => exact segment _ _ _ lo hi left right

def triple {α : Type} (a b c : α) (i : I) : α := if i = 0 then a else if i = 1 then b else c

def a : I → Point := triple (0,0) (1,0) (0,1)
def b : I → Point := triple (-1,-1) (1,0) (-1,1)
/-- Real change of basis U = (2J - 3I)/3, where J is all ones. -/
def u (i j : I) : Rat := if i = j then -1/3 else 2/3

def sum3 (f : I → Point) := add (add (f 0) (f 1)) (f 2)
def mixed (i j : I) : Point := add (if i = j then a i else (0,0))
  (sum3 (fun k => scale (u i k * u j k) (b k)))

def term (m : Matrix3) (i j k : I) : Point := mul (mul (m 0 i) (m 1 j)) (m 2 k)
def det3 (m : Matrix3) : Point := add (add (add (term m 0 1 2) (term m 1 2 0)) (term m 2 0 1))
  (neg (add (add (term m 2 1 0) (term m 0 2 1)) (term m 1 0 2)))

def permutations : List (I × I × I) := [(0,1,2), (0,2,1), (1,0,2), (1,2,0), (2,0,1), (2,1,0)]
def endpoint (p : I × I × I) : Point := mul (mul (add (a 0) (b p.1)) (add (a 1) (b p.2.1))) (add (a 2) (b p.2.2))
def vertices : List Point := permutations.map endpoint

theorem allPairings : ∀ i j k : I, (i,j,k) ∈ permutations ↔ i ≠ j ∧ i ≠ k ∧ j ≠ k := by decide +kernel
theorem orthogonal : ∀ i j : I, u i 0 * u j 0 + u i 1 * u j 1 + u i 2 * u j 2 = (if i = j then 1 else 0) := by decide +kernel
theorem determinantValue : det3 mixed = (2/3, 2/9) := by decide +kernel

/-- Original permutation hull for this normal pair. The nested weights give
9/27, 13/27, 5/27 at (2,1), (0,-1), (0,2) respectively. -/
theorem witnessInHull : InHull vertices (det3 mixed) := by
  have identity : det3 mixed = mix (1/3) (2,1) (mix (13/18) (0,-1) (0,2)) := by decide +kernel
  rw [identity]
  exact .blend (by decide +kernel) (by decide +kernel) (.vertex (by decide +kernel))
    (.blend (by decide +kernel) (by decide +kernel) (.vertex (by decide +kernel)) (.vertex (by decide +kernel)))

#print axioms inEveryConvexSet
#print axioms allPairings
#print axioms orthogonal
#print axioms determinantValue
#print axioms witnessInHull
end MathCommons
