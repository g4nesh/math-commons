{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "discovery-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "checkedClaims",
    "defects",
    "independentChecks",
    "statusBoundary",
    "kindAccurate"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "changes",
        "fail"
      ]
    },
    "summary": {
      "type": "string"
    },
    "checkedClaims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "location",
          "description",
          "suggestedRepair"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "location": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "suggestedRepair": {
            "type": "string"
          }
        }
      }
    },
    "independentChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "command",
          "outcome"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        }
      }
    },
    "statusBoundary": {
      "type": "string"
    },
    "kindAccurate": {
      "type": "boolean"
    }
  }
}
