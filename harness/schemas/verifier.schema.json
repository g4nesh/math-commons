{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "discovery-verifier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "verdict",
    "command",
    "checks"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
